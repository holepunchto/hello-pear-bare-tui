{
  "name": "hello-pear-bare-tui",
  "version": "0.0.0-rc.0",
  "description": "Pear Runtime terminal UI boilerplate using Bare and bare-tui with OTA updater support.",
  "private": true,
  "bin": "bin.mjs",
  "upgrade": "pear://<YOUR_KEY_HERE>",
  "scripts": {
    "inline-worker": "npx inline-worker-module hello-pear-worker",
    "format": "prettier . --write",
    "test": "brittle-bare test/index.js",
    "lint": "prettier . --check && lunte",
    "start": "bare bin.mjs --no-updates",
    "make": "node scripts/make.js",
    "make:darwin-arm64": "bare-build --standalone --host darwin-arm64 --out ./out/darwin-arm64 bin.mjs",
    "make:darwin-x64": "bare-build --standalone --host darwin-x64 --out ./out/darwin-x64 bin.mjs",
    "make:linux-arm64": "bare-build --standalone --host linux-arm64 --out ./out/linux-arm64 bin.mjs",
    "make:linux-x64": "bare-build --standalone --host linux-x64 --out ./out/linux-x64 bin.mjs",
    "make:win32-arm64": "bare-build --standalone --host win32-arm64 --out ./out/win32-arm64 bin.mjs",
    "make:win32-x64": "bare-build --standalone --host win32-x64 --out ./out/win32-x64 bin.mjs"
  },
  "dependencies": {
    "bare-os": "^3.9.4",
    "bare-path": "^3.1.2",
    "bare-process": "^4.5.1",
    "bare-storage": "^1.1.1",
    "bare-tty": "^5.2.2",
    "bare-tui": "^0.3.0",
    "corestore": "^7.16.1",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hyperswarm": "^4.17.2",
    "paparam": "^1.15.0",
    "pear-link": "^5.0.1",
    "pear-mobile": "^4.3.0",
    "pear-runtime": "^1.3.1",
    "ready-resource": "^1.2.0",
    "which-runtime": "^1.4.0"
  },
  "devDependencies": {
    "bare-build": "^1.6.2",
    "bare-runtime": "^1.37.0",
    "brittle": "^4.5.0",
    "hello-pear-worker": "^1.2.0",
    "inline-worker-module": "^1.0.0",
    "lunte": "^1.8.6",
    "prettier": "^3.9.10",
    "prettier-config-holepunch": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/hello-pear-bare-tui.git"
  },
  "author": "Holepunch Inc",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/hello-pear-bare-tui/issues"
  },
  "imports": {
    "pear-runtime": {
      "ios": "pear-mobile",
      "android": "pear-mobile",
      "simulator": "pear-mobile",
      "default": "pear-runtime"
    }
  }
}
